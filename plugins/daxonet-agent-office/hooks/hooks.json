{
  "description": "Reports Claude Code activity to the DAXONET agent office visualizer on localhost:4801. Does nothing when the visualizer isn't running.",
  "hooks": {
    "PreToolUse":         [{ "matcher": "*", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/app/1-claude-code-visualizer/hook.mjs\"", "timeout": 5 }] }],
    "PostToolUse":        [{ "matcher": "*", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/app/1-claude-code-visualizer/hook.mjs\"", "timeout": 5 }] }],
    "PostToolUseFailure": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/app/1-claude-code-visualizer/hook.mjs\"", "timeout": 5 }] }],
    "PermissionRequest":  [{ "matcher": "*", "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/app/1-claude-code-visualizer/hook.mjs\"", "timeout": 5 }] }],
    "SessionStart":       [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/app/1-claude-code-visualizer/hook.mjs\"", "timeout": 5 }] }],
    "SessionEnd":         [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/app/1-claude-code-visualizer/hook.mjs\"", "timeout": 5 }] }],
    "UserPromptSubmit":   [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/app/1-claude-code-visualizer/hook.mjs\"", "timeout": 5 }] }],
    "Notification":       [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/app/1-claude-code-visualizer/hook.mjs\"", "timeout": 5 }] }],
    "Stop":               [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/app/1-claude-code-visualizer/hook.mjs\"", "timeout": 5 }] }],
    "StopFailure":        [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/app/1-claude-code-visualizer/hook.mjs\"", "timeout": 5 }] }],
    "SubagentStart":      [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/app/1-claude-code-visualizer/hook.mjs\"", "timeout": 5 }] }],
    "SubagentStop":       [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/app/1-claude-code-visualizer/hook.mjs\"", "timeout": 5 }] }],
    "PreCompact":         [{ "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/app/1-claude-code-visualizer/hook.mjs\"", "timeout": 5 }] }]
  }
}
